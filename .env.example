# Copy to .env and fill. All keys stay SERVER-SIDE (Netlify env). None ship in the browser bundle.

# ───── Supabase ─────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ───── LLM providers ─────
COHERE_API_KEY=
OPENROUTER_API_KEY=
GEMMA_API_KEY=

# ───── Email ─────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sunvic Construction <no-reply@sunvicnj.com>

# ───── Public URL for signed links ─────
PUBLIC_SITE_URL=https://sunvicnj.com

# ───── Shared secret for public signed URLs ─────
SESSION_JWT_SECRET=

# ───── VITE (browser) — only two safe values ─────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───── Mock auth (login disabled) ─────
# Both default to "true" when unset → the app runs with a mocked local session and
# NO login screen / Supabase auth call. Set BOTH to "false" to restore real Supabase auth.
# MOCK_AUTH        → server (Netlify/Vercel Functions): verifyUser accepts the mock session.
# VITE_MOCK_AUTH   → browser bundle: useSession/getAccessToken return the mock session/token.
MOCK_AUTH=true
VITE_MOCK_AUTH=true
